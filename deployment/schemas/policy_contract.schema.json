{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "schema_version",
    "robot_model",
    "joint_names",
    "default_joint_position_rad",
    "default_joint_velocity_rad_s",
    "policy_period_s",
    "observation",
    "action",
    "frames",
    "target_workspace_m",
    "deployment_observation_noise",
    "observation_layout"
  ],
  "properties": {
    "schema_version": {"enum": [1, 2]},
    "contract_id": {"type": "string"},
    "robot_model": {"enum": ["panda", "fr3"]},
    "robot_description": {"type": "string"},
    "joint_names": {
      "type": "array",
      "items": {"type": "string"},
      "minItems": 7,
      "maxItems": 7
    },
    "default_joint_position_rad": {
      "type": "array",
      "items": {"type": "number"},
      "minItems": 7,
      "maxItems": 7
    },
    "default_joint_velocity_rad_s": {
      "type": "array",
      "items": {"type": "number"},
      "minItems": 7,
      "maxItems": 7
    },
    "policy_period_s": {"type": "number", "exclusiveMinimum": 0},
    "observation": {
      "type": "object",
      "required": ["size", "dtype", "terms", "normalization", "previous_action", "reset_previous_action"],
      "properties": {
        "size": {"enum": [24, 29, 31]},
        "dtype": {"const": "float32"},
        "terms": {"type": "array", "items": {"type": "string"}},
        "normalization": {"const": false},
        "previous_action": {"type": "string"},
        "reset_previous_action": {"type": "array", "items": {"type": "number"}},
        "reference_initialization": {"type": "string"}
      },
      "additionalProperties": false
    },
    "action": {
      "type": "object",
      "required": ["size", "dtype", "inference"],
      "properties": {
        "type": {"type": "string"},
        "size": {"enum": [6, 7]},
        "dtype": {"const": "float32"},
        "inference": {"enum": ["deterministic_mean", "deterministic_tanh"]},
        "mapping": {"type": "string"},
        "scale_rad": {"type": "number", "exclusiveMinimum": 0},
        "clip": {"type": ["null", "array"]},
        "normalized_bounds": {"type": "array", "items": {"type": "number"}, "minItems": 2, "maxItems": 2},
        "integration": {"type": "string"},
        "initial_reference": {"type": "string"},
        "controlled_joint_names": {"type": "array", "items": {"type": "string"}},
        "held_joint_names": {"type": "array", "items": {"type": "string"}},
        "max_reference_velocity_rad_s": {"type": "array", "items": {"type": "number"}},
        "max_position_increment_rad": {"type": "array", "items": {"type": "number"}},
        "soft_limit_projection": {"type": "boolean"},
        "soft_lower_rad": {"type": "array", "items": {"type": "number"}},
        "soft_upper_rad": {"type": "array", "items": {"type": "number"}}
      },
      "additionalProperties": false
    },
    "frames": {
      "type": "object",
      "required": ["base", "tracked_body"],
      "properties": {"base": {"type": "string"}, "tracked_body": {"type": "string"}},
      "additionalProperties": false
    },
    "target_workspace_m": {
      "type": "object",
      "required": ["x", "y", "z"],
      "properties": {
        "x": {"type": "array", "items": {"type": "number"}, "minItems": 2, "maxItems": 2},
        "y": {"type": "array", "items": {"type": "number"}, "minItems": 2, "maxItems": 2},
        "z": {"type": "array", "items": {"type": "number"}, "minItems": 2, "maxItems": 2}
      },
      "additionalProperties": false
    },
    "deployment_observation_noise": {"const": false},
    "observation_layout": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["start", "stop", "expression", "unit"],
        "properties": {
          "start": {"type": "integer", "minimum": 0},
          "stop": {"type": "integer", "minimum": 1},
          "expression": {"type": "string"},
          "unit": {"type": "string"}
        },
        "additionalProperties": false
      }
    },
    "controller": {"type": "object"}
  },
  "oneOf": [
    {
      "properties": {"schema_version": {"const": 1}, "robot_model": {"const": "panda"}},
      "not": {"required": ["contract_id"]}
    },
    {
      "required": ["contract_id", "robot_description", "controller"],
      "properties": {
        "schema_version": {"const": 2},
        "contract_id": {"const": "fr3_incremental_position_29d_v1"},
        "robot_model": {"const": "fr3"}
      }
    }
  ],
  "additionalProperties": false
}
